<Project Sdk="Microsoft.NET.Sdk">
  <!-- Linux/cross-platform build. On Windows the in-box build.ps1 (csc) still works too. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PtoServer</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Workstation, non-concurrent GC: smallest idle RAM footprint (see hosting notes). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!-- Launcher/ is its own project (net10 + Steamworks); keep its sources out of the
       server build, which otherwise globs every .cs under the repo root. -->
  <ItemGroup>
    <Compile Remove="Launcher/**/*.cs" />
  </ItemGroup>
</Project>
